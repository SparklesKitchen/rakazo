# CHR-204: include this inside the existing workmateos.co.uk site block only
# after its SaaS Admin authentication/routing guard. It has no site label and
# therefore cannot create a public Rakazo origin.
#
# The WorkMate application is responsible for issuing the short-lived handoff
# assertion. This proxy is transport-only and never authenticates a Rakazo
# user, offers registration, or routes to bots.workmateos.co.uk.
handle_path /saas-admin/rakazo/* {
	reverse_proxy 127.0.0.1:25173
}
