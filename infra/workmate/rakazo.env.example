# Copy to an operator-owned, mode-0600 path outside the checkout, for example
# /etc/workmate/rakazo.env. Values are intentionally omitted from this template.
NODE_ENV=production
RAKAZO_INTEGRATION_MODE=workmate

# Private Managed Supabase connection strings. They must target the private
# `rakazo` runtime authority and are never browser-visible.
DATABASE_URL=
REALTIME_DATABASE_URL=
WORKMATE_RAKAZO_DATABASE_URL=

# Shared only with WorkMate's server-side assertion issuer; never expose it to
# the web build or a Caddy directive.
WORKMATE_RAKAZO_ASSERTION_SECRET=

# Required when SANDBOX_PROVIDER=e2b. This is the sole direct external runtime
# credential allowed in this overlay; model and connected-account calls remain
# WorkMate Router / Connected-Account Tool Bridge responsibilities.
E2B_API_KEY=
